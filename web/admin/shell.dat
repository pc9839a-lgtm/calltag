<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
  <title>콜태그 관리자</title>
  <link rel="stylesheet" href="/admin/admin.css?v=20260813-2" />
  <link rel="stylesheet" href="/admin/payout-request.css?v=20260813-payout1" />
  <link rel="stylesheet" href="/admin/admin-ops.css?v=20261016-subscriber-parity6" />
  <link rel="stylesheet" href="/admin/admin-theme.css?v=20260813-theme1" />
  <link rel="stylesheet" href="/admin/ops-dashboard.css?v=20261021-dashboard1" />
  <link rel="stylesheet" href="/admin/member-detail.css?v=20261020-detail-v2" />
</head>
<body>
  <header class="topbar">
    <div class="brand"><strong>콜태그 관리자</strong><span id="adminModeBadge">READ ONLY</span></div>
    <nav class="tabs" aria-label="관리 메뉴">
      <button id="membersTab" class="tab active" type="button">회원</button>
      <button id="partnersTab" class="tab" type="button">파트너·정산</button>
    </nav>
    <div class="actions"><span id="adminIdentity"></span><button id="refreshButton" type="button">새로고침</button></div>
  </header>
  <div id="statusBar" class="statusbar">운영 데이터 연결 확인 중</div>

  <main class="wrap">
    <section id="membersView">

      <section id="opsHealthPanel" class="ops-health ops-member-dashboard" aria-label="회원 현황 대시보드">
        <div class="ops-health-header">
          <div class="ops-health-heading"><h1>회원 현황</h1></div>
          <span id="opsCheckedAt" class="ops-last-checked" aria-live="polite">불러오는 중</span>
        </div>
        <div class="ops-health-grid">
          <div class="ops-indicator"><span>전체 회원</span><strong id="opsTotalMembers">—</strong></div>
          <div class="ops-indicator"><span>7일 신규</span><strong id="opsNewMembers">—</strong></div>
          <div class="ops-indicator"><span>체험 중</span><strong id="opsTrialMembers">—</strong></div>
          <div class="ops-indicator"><span>유료 회원</span><strong id="opsVerifiedSubscribers">—</strong></div>
        </div>
      </section>
      <section id="membersPanel" class="panel">
        <div class="panelhead compact-members-head">
          <div class="member-heading"><div><h1>회원 목록</h1><p id="generatedAt"></p></div><strong id="memberResultCount" class="member-result-count" aria-live="polite">—</strong></div>
          <div class="member-tools member-tools-compact">
            <div id="memberQuickFilters" class="member-quick-filters" role="group" aria-label="회원 빠른 필터">
              <button type="button" class="member-filter-chip is-active" data-member-filter="all" aria-pressed="true">전체</button>
              <button type="button" class="member-filter-chip" data-member-filter="paid" aria-pressed="false">유료</button>
              <button type="button" class="member-filter-chip" data-member-filter="trial" aria-pressed="false">체험중</button>
              <button type="button" class="member-filter-chip" data-member-filter="review" aria-pressed="false">확인필요</button>
              <button type="button" class="member-filter-chip" data-member-filter="admin" aria-pressed="false">관리자지급</button>
            </div>
            <div class="member-search-inline">
              <input id="memberSearchInput" type="search" maxlength="80" autocomplete="off" placeholder="회원ID · 이메일 · 전화번호" aria-label="회원 검색" />
              <button id="memberSearchButton" type="button">검색</button>
              <button id="memberFilterToggle" type="button" aria-controls="memberAdvancedPanel" aria-expanded="false">상세 필터</button>
            </div>
          </div>
          <section id="memberAdvancedPanel" class="member-advanced-panel" aria-label="회원 상세 필터" hidden>
            <div class="member-advanced-grid">
              <label>가입일
                <select id="memberDateRange">
                  <option value="all">전체 기간</option><option value="today">오늘</option>
                  <option value="7">최근 7일</option><option value="30">최근 30일</option>
                  <option value="custom">기간 직접 선택</option>
                </select>
              </label>
              <label>시작일 <input id="memberDateFrom" type="date" disabled /></label>
              <label>종료일 <input id="memberDateTo" type="date" disabled /></label>
              <label>이용권
                <select id="memberPlanFilter">
                  <option value="all">전체</option><option value="trial">무료체험</option>
                  <option value="call_monthly">전화관리</option><option value="message_monthly">문자자동화</option>
                  <option value="all_monthly">통합권</option><option value="pagero_monthly">페이지로 클래식</option>
                  <option value="pagero_pro_monthly">페이지로 프로</option><option value="pagero_domain_monthly">SSL</option>
                  <option value="admin">관리자 지급</option><option value="other">기타 이용권</option>
                </select>
              </label>
              <label>이용 상태
                <select id="memberUsageFilter">
                  <option value="all">전체</option><option value="trial">체험중</option>
                  <option value="active">활성</option><option value="cancelled">취소예정</option>
                  <option value="expired">만료</option><option value="suspended">정지</option>
                  <option value="review">확인필요</option>
                </select>
              </label>
              <label>결제 검증
                <select id="memberVerificationFilter">
                  <option value="all">전체</option><option value="normal">정상</option>
                  <option value="review">확인필요</option><option value="failed">실패</option>
                  <option value="none">해당없음</option>
                </select>
              </label>
              <label>구독·결제
                <select id="memberBillingFilter">
                  <option value="all">전체</option><option value="paid">유료구독</option>
                  <option value="trial">무료체험</option><option value="admin">관리자 지급</option>
                  <option value="past">과거 결제</option><option value="missing">결제 자료 없음</option>
                  <option value="review">구독 검증필요</option>
                </select>
              </label>
              <label>결제 채널
                <select id="memberChannelFilter">
                  <option value="all">전체</option><option value="google_play">Google Play</option>
                  <option value="web">웹 결제</option><option value="admin">관리자 지급</option>
                </select>
              </label>
              <label>결제 이력
                <select id="memberHistoryFilter">
                  <option value="all">전체</option><option value="yes">확인 기록 있음</option>
                  <option value="no">확인 기록 없음</option>
                </select>
              </label>
              <label>기존 지급·구매 기록
                <select id="memberEvidenceFilter">
                  <option value="all">전체 회원</option><option value="granted">지급 이력만</option>
                  <option value="purchased">결제·구독 검증</option>
                </select>
              </label>
              <label>정렬
                <select id="memberSort">
                  <option value="newest">최신 가입순</option><option value="oldest">오래된 가입순</option>
                  <option value="paid">유료 우선</option><option value="review">확인필요 우선</option>
                </select>
              </label>
            </div>
            <p id="memberFilterError" class="member-filter-error" role="alert" hidden></p>
            <div class="member-advanced-actions"><button id="memberFilterReset" type="button">초기화</button><button id="memberFilterApply" type="button">필터 적용</button></div>
          </section>
          <div id="memberFilterChips" class="member-active-filters" aria-label="적용된 필터" hidden></div>
        </div>
        <div class="tablewrap member-tablewrap">
          <table class="member-compact-table">
            <colgroup><col class="col-member"><col class="col-email"><col class="col-date"><col class="col-plan"><col class="col-usage"><col class="col-proof"><col class="col-billing"><col class="col-action"></colgroup>
            <thead><tr><th>회원 ID</th><th>이메일</th><th>가입일</th><th>이용권</th><th>이용 상태</th><th>결제 검증</th><th>구독·결제</th><th>관리</th></tr></thead>
            <tbody id="memberRows"></tbody>
          </table>
        </div>
        <div id="emptyMembers" class="empty">운영 데이터 접근이 잠겨 있습니다.</div>
        <div class="member-pagination"><button id="memberPrev" type="button">이전</button><span id="memberPageInfo">1 / 1</span><button id="memberNext" type="button">다음</button></div>
      </section>
        <details id="payerAuditDetails" class="admin-fold audit-fold">
          <summary>결제·구독 점검</summary>
          <div class="admin-fold-content">
            <div class="admin-fold-tools">
            <button id="payerAuditRefresh" type="button">전체 결제 누락 점검</button>
            <button id="playRenewalReconcile" type="button">Google Play 구독 갱신 확인</button>
            <span id="playRenewalStatus" class="member-result-count" role="status"></span>
            </div>
        <section id="payerAuditPanel" class="payer-audit" aria-live="polite">
          <div class="payer-audit-heading"><strong>전체 결제 이력 대조</strong><span id="payerAuditStatus"></span></div>
          <div id="payerAuditSummary" class="payer-audit-summary"></div>
          <div class="tablewrap payer-audit-table" id="payerAuditTableWrap" hidden>
            <table><thead><tr><th>회원 ID</th><th>이메일</th><th>회원 목록</th><th>기록 판정</th><th>구독 상태</th><th>Google Play 확인</th></tr></thead><tbody id="payerAuditRows"></tbody></table>
          </div>
        </section>
          </div>
        </details>
      <div class="admin-secondary">
        <details id="extraStatsDetails" class="admin-fold">
          <summary>회원 세부 통계 · 예상 매출</summary>
          <div class="admin-fold-content">
      <section class="metrics">
        <article><span>전체 회원</span><strong id="metricTotal">—</strong></article>
        <article><span>7일 신규</span><strong id="metricNew">—</strong></article>
        <article><span>체험 중</span><strong id="metricTrial">—</strong></article>
        <article><span>유료 구독 활성</span><strong id="metricPaid">—</strong></article>
        <article><span>결제 확인 필요</span><strong id="metricPaymentReview">—</strong></article>
        <article><span>파트너 적립 대기</span><strong id="metricPartner">—</strong></article>
      </section>
      <section class="metrics revenue-metrics">
        <article><span>월 예상 매출</span><strong id="metricRevenueGross">—</strong></article>
        <article><span>Play 15% 예상 수수료</span><strong id="metricPlayFee">—</strong></article>
        <article><span>수수료 제외 예상매출</span><strong id="metricRevenueNet">—</strong></article>
      </section>
          </div>
        </details>
        <details id="financeDetails" class="admin-fold">
          <summary>Google Play 실제 정산</summary>
          <div class="admin-fold-content">
      <div id="playFinancePanel" class="viewbar">
        <div><strong>Google Play 확정 정산</strong><span id="playFinanceMeta">수익보고서 연결 확인 중</span></div>
        <label class="play-monthpick"><span>정산 월</span><select id="playFinanceMonth" aria-label="Google Play 정산 월"><option value="">불러오는 중</option></select></label>
      </div>
      <section class="metrics partner-metrics">
        <article><span>Play 실매출</span><strong id="playActualCustomer">—</strong></article>
        <article><span>Google 실제 수수료</span><strong id="playActualFee">—</strong></article>
        <article><span>Play 실제 정산액</span><strong id="playActualNet">—</strong></article>
        <article><span>파트너 발생액</span><strong id="playActualPartner">—</strong></article>
        <article><span>최종 남는 금액</span><strong id="playActualFinal">—</strong></article>
      </section>
          </div>
        </details>
      </div>
    </section>

    <section id="partnersView" hidden>
      <div class="viewbar">
        <div><strong>파트너 정산</strong></div>
        <label class="monthpick"><span>정산 월</span><input id="partnerMonth" type="month" min="2026-01" /></label>
      </div>
      <section class="metrics partner-metrics">
        <article><span>파트너</span><strong id="partnerCount">—</strong></article>
        <article><span>지급요청</span><strong id="partnerRequested">—</strong><small id="partnerRequestedAmount">—</small></article>
        <article><span>월 결제매출</span><strong id="partnerGross">—</strong></article>
        <article><span>발생 수수료</span><strong id="partnerEarned">—</strong></article>
        <article><span>미지급</span><strong id="partnerPayable">—</strong></article>
        <article><span>지급완료</span><strong id="partnerPaid">—</strong></article>
      </section>
      <section class="panel">
        <div class="panelhead"><div><h1>파트너 목록</h1><p id="partnerGeneratedAt"></p></div></div>
        <div class="tablewrap">
          <table class="partner-table">
            <thead><tr><th>파트너</th><th>추천코드</th><th>수수료</th><th>추천</th><th>유료</th><th>월 매출</th><th>발생 수수료</th><th>미지급</th><th>지급완료</th><th>상태</th><th></th></tr></thead>
            <tbody id="partnerRows"></tbody>
          </table>
        </div>
        <div id="emptyPartners" class="empty">파트너 데이터가 없습니다.</div>
      </section>
    </section>
  </main>

  <div id="detailBackdrop" class="backdrop" hidden></div>
  <aside id="memberDetail" class="drawer" hidden>
    <div class="drawerhead"><div><strong id="detailTitle">상세</strong><small id="detailOwnerId"></small></div><button id="detailClose" type="button" aria-label="닫기">×</button></div>
    <div id="detailBody" class="drawerbody"></div>
  </aside>
  <script src="/admin/admin.js?v=20261021-clean1" defer></script>
  <script src="/admin/payout-request.js?v=20260813-payout1" defer></script>
  <script src="/admin/play-finance-monthly.js?v=20260813-month1" defer></script>
  <script src="/admin/member-ops.js?v=20261021-filters1" defer></script>
  <script src="/admin/payer-audit.js?v=20261021-clean1" defer></script>
  <script src="/admin/play-renewal-reconcile.js?v=20261016-playrenewal1" defer></script>
  <script src="/admin/member-ops-sync.js?v=20260813-ops1" defer></script>
  <script src="/admin/admin-theme.js?v=20260813-theme1" defer></script>
  <script src="/admin/partner-security.js?v=20260813-totp1" defer></script>
  <script src="/admin/ops-dashboard.js?v=20261021-dashboard1" defer></script>
</body>
</html>