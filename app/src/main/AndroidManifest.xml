<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".CallTagApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallTag">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity android:name=".InitialPermissionActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".MessageAutomationSettingsActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MessageTemplateLibraryActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MessageTemplateEditorActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CustomerMessagePickerActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".GroupCampaignHubActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".MessageSafetyHubActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".TemplateImageLibraryActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".TemplateImageActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".MmsComposeActivity" android:excludeFromRecents="true" android:exported="false" android:noHistory="true" android:theme="@style/Theme.CallTag" />
        <activity android:name=".MessageExclusionActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PostCallExclusionActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ManualMessageActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MessageHistoryActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".MessageGroupActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CampaignListActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".CampaignComposerActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CampaignDetailActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".CalendarSharePickerActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BillingEntitlementActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".SettingsGroupActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".AppInfoActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".CustomerSupportActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EntitlementNoticeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ReferralPartnerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PartnerSettlementActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PageroConnectionActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PageroConnectionCompactActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PageroUseGuideActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PageroLeadNotificationActivity" android:exported="false" android:screenOrientation="portrait" />

        <activity
            android:name=".CallerInfoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:theme="@style/Theme.CallTag.CallerInfo"
            android:turnScreenOn="true" />

        <activity android:name=".CallerIdSetupActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".TaskTypeSettingsActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".StageSettingsActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AccountActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".BackupRestoreActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".CallTagSyncStatusActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".CallTagSyncDevicesActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GoogleCredentialLoginActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CallTag.GoogleCredentialBridge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="calltag"
                    android:host="credential"
                    android:path="/google" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GoogleAuthCallbackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.CallTag">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="calltag"
                    android:host="auth"
                    android:path="/google" />
            </intent-filter>
        </activity>
        <activity android:name=".CustomerAddActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CustomerDetailActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CustomerQuickEditActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HomeTaskEditorActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity
            android:name=".PostCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="false"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:theme="@style/Theme.CallTag.PostCallPopup"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MainActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AuthGateActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pagero.kr" android:pathPrefix="/r/" />
                <data android:scheme="https" android:host="www.pagero.kr" android:pathPrefix="/r/" />
            </intent-filter>
        </activity>

        <service
            android:name=".CallTagAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/calltag_account_authenticator" />
        </service>

        <service
            android:name=".CallTagContactSyncService"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/calltag_contact_sync_adapter" />
        </service>

        <service android:name=".CallTagScreeningService" android:exported="true" android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".CallTagMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service android:name=".CallMonitorService" android:enabled="true" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled phone CRM and SMS automation that observes call state, creates follow-up work, and sends configured messages after calls." />
        </service>

        <receiver android:name=".ScheduledMessageReceiver" android:enabled="true" android:exported="false" />
        <receiver android:name=".SmsStatusReceiver" android:enabled="true" android:exported="false" />
        <receiver android:name=".BootReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
