<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CallTag" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Widget.CallTag.Button</item>
        <item name="android:switchStyle">@style/Widget.CallTag.Switch</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:alertDialogTheme">@style/Theme.CallTag.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.CallTag.PickerDialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.CallTag.PickerDialog</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="Widget.CallTag.Button" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.CallTag.Switch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:textSize">0sp</item>
        <item name="android:switchMinWidth">48dp</item>
        <item name="android:switchPadding">0dp</item>
        <item name="android:thumbTint">@color/switch_thumb_tint</item>
        <item name="android:trackTint">@color/switch_track_tint</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="Theme.CallTag.CallerInfo" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.CallTag.PostCallPopup" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Widget.CallTag.Button</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.CallTag.Dialog</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>

    <style name="Theme.CallTag.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Widget.CallTag.Button</item>
        <item name="android:windowBackground">@drawable/bg_dialog_panel</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:selectableItemBackground">@drawable/bg_dialog_choice</item>
        <item name="android:listPreferredItemHeightSmall">56dp</item>
        <item name="android:listViewStyle">@style/Widget.CallTag.DialogList</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.CallTag.PickerDialog" parent="@style/Theme.CallTag.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_panel</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Widget.CallTag.DialogList" parent="android:style/Widget.Material.ListView">
        <item name="android:divider">@drawable/dialog_list_divider</item>
        <item name="android:dividerHeight">4dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:clipToPadding">false</item>
    </style>
</resources>
