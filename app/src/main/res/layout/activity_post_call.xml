<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:id="@+id/postCallClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="통화 후 정리"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingLeft="20dp"
        android:paddingTop="22dp"
        android:paddingRight="20dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/postCallPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/postCallMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/postCallExistingInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="고객 구분"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/relationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/relationNew"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/primary"
                    android:text="신규 문의 고객"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/relationExisting"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/primary"
                    android:text="기존 고객"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/relationExcluded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/primary"
                    android:text="개인전화·거래처·제외번호"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/postCallName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="고객명 또는 업체명"
                android:hintTextColor="@color/text_muted"
                android:inputType="textCapWords"
                android:padding="15dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="상담 결과"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/postCallResultButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/postCallNote"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="상담 내용 한 줄 메모"
                android:hintTextColor="@color/text_muted"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="다음 연락"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/followUpGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/followNone"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:buttonTint="@color/primary"
                    android:checked="true"
                    android:text="등록하지 않음"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/followTomorrow"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:buttonTint="@color/primary"
                    android:text="내일 다시 연락"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/followThreeDays"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:buttonTint="@color/primary"
                    android:text="3일 후 다시 연락"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/followWeek"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:buttonTint="@color/primary"
                    android:text="다음 주 다시 연락"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <Button
                android:id="@+id/postCallSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_primary_button"
                android:text="저장하고 끝내기"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
